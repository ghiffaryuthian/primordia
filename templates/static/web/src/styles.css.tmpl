:root {
  color: #172026;
  background: #f5f7f8;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

button,
input,
textarea,
select {
  font: inherit;
}

.shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px;
}

.panel {
  width: min(780px, 100%);
}

.eyebrow {
  color: #64748b;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 1;
}

.lede {
  color: #475569;
  font-size: 1.05rem;
  line-height: 1.7;
  max-width: 62ch;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
  margin: 28px 0;
}

.status-grid div {
  border: 1px solid #d7dee8;
  border-radius: 8px;
  background: #ffffff;
  padding: 14px 16px;
}

.status-grid dt {
  color: #64748b;
  font-size: 0.76rem;
  font-weight: 700;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.status-grid dd {
  margin: 0;
  color: #1e293b;
  font-weight: 700;
}

.error {
  color: #b42318;
  font-size: 0.92rem;
}

.domains {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 0;
  margin: 28px 0 0;
  list-style: none;
}

.domains li {
  border: 1px solid #cbd5e1;
  border-radius: 999px;
  padding: 8px 12px;
  background: #ffffff;
  font-size: 0.92rem;
}
