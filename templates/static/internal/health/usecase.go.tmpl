package health

import (
	"context"
	"time"

	"go.opentelemetry.io/otel/trace"
)

type Usecase struct {
	serviceName string
	environment string
	tracer      trace.Tracer
}

func NewUsecase(serviceName string, environment string, tracer trace.Tracer) *Usecase {
	return &Usecase{serviceName: serviceName, environment: environment, tracer: tracer}
}

func (u *Usecase) GetHealth(ctx context.Context) (Status, error) {
	_, span := u.tracer.Start(ctx, "health.usecase.get")
	defer span.End()

	return Status{
		ServiceName: u.serviceName,
		Environment: u.environment,
		CheckedAt:   time.Now(),
	}, nil
}
