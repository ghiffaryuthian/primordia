package observability

import (
	"context"
	"errors"
	"log/slog"
	"os"

	"__GO_MODULE__/internal/infra/observability/registry"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
	"go.opentelemetry.io/otel/exporters/stdout/stdoutmetric"
	"go.opentelemetry.io/otel/metric"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	semconv "go.opentelemetry.io/otel/semconv/v1.40.0"
)

type Runtime struct {
	meterProvider  *sdkmetric.MeterProvider
	tracerProvider *sdktrace.TracerProvider
	logger         *slog.Logger
}

type Scope struct {
	name    string
	runtime *Runtime
}

type Instrumentation interface {
	Logger() *slog.Logger
	Meter() metric.Meter
	Metrics() (*registry.MetricsRegistry, error)
	Tracer() *registry.TracesRegistry
}

func Init(ctx context.Context, collectorEndpoint string, serviceName string, environment string) (*Runtime, error) {
	res, err := resource.New(ctx,
		resource.WithAttributes(
			semconv.ServiceName(serviceName),
			semconv.DeploymentEnvironmentName(environment),
			attribute.String("service.namespace", "app"),
		),
		resource.WithHost(),
	)
	if err != nil {
		return nil, err
	}

	traceExporter, err := otlptracegrpc.New(ctx,
		otlptracegrpc.WithEndpoint(collectorEndpoint),
		otlptracegrpc.WithInsecure(),
	)
	if err != nil {
		return nil, err
	}

	metricExporter, err := otlpmetricgrpc.New(ctx,
		otlpmetricgrpc.WithEndpoint(collectorEndpoint),
		otlpmetricgrpc.WithInsecure(),
	)
	if err != nil {
		return nil, err
	}

	consoleMetricExporter, err := stdoutmetric.New(stdoutmetric.WithPrettyPrint())
	if err != nil {
		return nil, err
	}

	tracerProvider := sdktrace.NewTracerProvider(
		sdktrace.WithResource(res),
		sdktrace.WithBatcher(traceExporter),
	)
	meterProvider := sdkmetric.NewMeterProvider(
		sdkmetric.WithResource(res),
		sdkmetric.WithReader(sdkmetric.NewPeriodicReader(metricExporter)),
		sdkmetric.WithReader(sdkmetric.NewPeriodicReader(consoleMetricExporter)),
	)

	otel.SetTracerProvider(tracerProvider)
	otel.SetMeterProvider(meterProvider)

	return &Runtime{
		meterProvider:  meterProvider,
		tracerProvider: tracerProvider,
		logger:         slog.New(slog.NewJSONHandler(os.Stdout, nil)),
	}, nil
}

func (r *Runtime) Scope(name string) Scope {
	return Scope{name: name, runtime: r}
}

func (r *Runtime) Shutdown(ctx context.Context) error {
	if r == nil {
		return nil
	}
	var traceErr error
	if r.tracerProvider != nil {
		traceErr = r.tracerProvider.Shutdown(ctx)
	}
	var metricErr error
	if r.meterProvider != nil {
		metricErr = r.meterProvider.Shutdown(ctx)
	}
	return errors.Join(traceErr, metricErr)
}

func (s Scope) Logger() *slog.Logger {
	return s.runtime.logger.With("scope", s.name)
}

func (s Scope) Meter() metric.Meter {
	return s.runtime.meterProvider.Meter(s.name)
}

func (s Scope) Metrics() (*registry.MetricsRegistry, error) {
	return registry.NewMetricsRegistry(s.Meter())
}

func (s Scope) Tracer() *registry.TracesRegistry {
	return registry.NewTracesRegistry(s.runtime.tracerProvider.Tracer(s.name))
}
