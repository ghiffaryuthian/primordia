name: __SERVICE_SLUG__-app
services:
  api:
    container_name: __SERVICE_SLUG__-api
    build:
      context: ../..
      dockerfile: Dockerfile
      target: api
    environment:
      APP_ENVIRONMENT: ${APP_ENVIRONMENT:-development}
      SERVER_ADDRESS: :8080
      DATABASE_HOST: db
      DATABASE_PORT: 5432
      DATABASE_USER: ${DATABASE_USER:-postgres}
      DATABASE_PASSWORD: ${DATABASE_PASSWORD:-__SERVICE_SLUG__}
      DATABASE_NAME: ${DATABASE_NAME:-__SERVICE_PROTO__}
      OTEL_COLLECTOR_ENDPOINT: ${OTEL_COLLECTOR_ENDPOINT:-otel-collector:4317}
    ports:
      - "${API_PORT:-8080}:8080"
    restart: unless-stopped

  web:
    container_name: __SERVICE_SLUG__-web
    build:
      context: ../..
      dockerfile: Dockerfile.web
      target: web
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-http://localhost:8080}
    environment:
      APP_ENVIRONMENT: ${APP_ENVIRONMENT:-development}
      OTEL_COLLECTOR_ENDPOINT: ${OTEL_COLLECTOR_ENDPOINT:-otel-collector:4317}
      VITE_WEB_SERVER_ADDRESS: 0.0.0.0
      VITE_WEB_PORT: 3000
      WEB_DIST_DIR: /app/web-public
    ports:
      - "${WEB_PORT:-3000}:3000"
    depends_on:
      - api
    restart: unless-stopped
