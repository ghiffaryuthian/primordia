name: __SERVICE_SLUG__-dev
services:
  db:
    image: postgres:17-alpine
    container_name: __SERVICE_SLUG__-dev-db
    environment:
      POSTGRES_USER: ${DATABASE_USER:-postgres}
      POSTGRES_PASSWORD: ${DATABASE_PASSWORD:-__SERVICE_SLUG__}
      POSTGRES_DB: ${DATABASE_NAME:-__SERVICE_PROTO__}
    ports:
      - "${DATABASE_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DATABASE_USER:-postgres} -d ${DATABASE_NAME:-__SERVICE_PROTO__}"]
      interval: 5s
      timeout: 5s
      retries: 20
    volumes:
      - db-data:/var/lib/postgresql/data

volumes:
  db-data:
