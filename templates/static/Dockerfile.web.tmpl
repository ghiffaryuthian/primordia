FROM node:24-bookworm AS web-assets-builder

WORKDIR /src/web
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY web/package.json ./
RUN --mount=type=cache,id=primordia-web-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --store-dir /pnpm/store
COPY web ./
ARG VITE_API_BASE_URL=http://localhost:8080
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm run build

FROM golang:1.26.2-bookworm AS web-go-builder

WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/web ./cmd/web

FROM gcr.io/distroless/static-debian12:nonroot AS web

WORKDIR /app
COPY --from=web-go-builder /out/web /app/web
COPY --from=web-assets-builder /src/web/dist /app/web-public
ENV WEB_DIST_DIR=/app/web-public
ENV VITE_WEB_SERVER_ADDRESS=0.0.0.0
ENV VITE_WEB_PORT=3000
EXPOSE 3000
ENTRYPOINT ["/app/web"]
